{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/zigzag-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },

  "ConnectionStrings": {
    "//": "Local dev only - no production data. Password comes from .env / user-secrets; see .env.example.",
    "ZigZagDb": "Host=localhost;Port=5432;Database=zigzag;Username=zigzag;Password=zigzag;Include Error Detail=true"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
